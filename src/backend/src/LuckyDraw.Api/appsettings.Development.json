{
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Draw": {
    "DailyLimit": 3,
    "Deterministic": {
      "Enabled": false,
      "ForcedResults": []
    }
  },
  "Prize": {
    "WeightOverrides": {}
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
